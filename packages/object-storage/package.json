{
    "name": "@agentic-workspace/object-storage",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./local-folder": {
            "types": "./dist/local-folder.d.ts",
            "import": "./dist/local-folder.js",
            "default": "./dist/local-folder.js"
        }
    }
}
