{
    "$schema": "https://json-schema.org/schema",
    "$id": "Agentic WorkspaceServiceE2eGenerator",
    "title": "Agentic Workspace Service E2E Generator",
    "description": "Creates the canonical E2E project for an internal HTTP service.",
    "type": "object",
    "properties": {
        "name": {
            "type": "string",
            "description": "Service name in lowercase kebab-case.",
            "$default": {
                "$source": "argv",
                "index": 0
            },
            "x-prompt": "What is the service name?"
        }
    },
    "required": ["name"]
}
